+lv_obj_t* MakePanel(lv_obj_t* parent, int x, int y, int w, int h, uint32_t bg, int radius = 18) {
+    auto* obj = lv_obj_create(parent);
+    lv_obj_set_pos(obj, x, y);
+    lv_obj_set_size(obj, w, h);
+    lv_obj_set_style_radius(obj, radius, 0);
+    lv_obj_set_style_bg_color(obj, lv_color_hex(bg), 0);
+    lv_obj_set_style_bg_opa(obj, LV_OPA_COVER, 0);
+    lv_obj_set_style_border_color(obj, lv_color_hex(kBorder), 0);
+    lv_obj_set_style_border_width(obj, 1, 0);
+    lv_obj_set_style_pad_all(obj, 0, 0);
+    lv_obj_set_scrollbar_mode(obj, LV_SCROLLBAR_MODE_OFF);
+    lv_obj_remove_flag(obj, LV_OBJ_FLAG_SCROLLABLE);
+    return obj;
+}
+
+lv_obj_t* MakeLabel(lv_obj_t* parent, const char* text, int x, int y, int w,
+                    uint32_t color, const lv_font_t* font = &BUILTIN_TEXT_FONT,
+                    lv_text_align_t align = LV_TEXT_ALIGN_LEFT) {
+    auto* label = lv_label_create(parent);
+    lv_label_set_text(label, text ? text : "");
+    lv_obj_set_pos(label, x, y);
+    lv_obj_set_width(label, w);
+    lv_obj_set_style_text_color(label, lv_color_hex(color), 0);
+    lv_obj_set_style_text_font(label, font, 0);
+    lv_obj_set_style_text_align(label, align, 0);
+    return label;
+}
+
+void StyleRoot(lv_obj_t* root) {
+    lv_obj_set_pos(root, 0, 0);
+    lv_obj_set_size(root, 480, 320);
+    lv_obj_set_style_radius(root, 0, 0);
+    lv_obj_set_style_border_width(root, 0, 0);
+    lv_obj_set_style_pad_all(root, 0, 0);
+    lv_obj_set_style_bg_color(root, lv_color_hex(kBgTop), 0);
+    lv_obj_set_style_bg_grad_color(root, lv_color_hex(kBgBottom), 0);
+    lv_obj_set_style_bg_grad_dir(root, LV_GRAD_DIR_VER, 0);
+    lv_obj_set_scrollbar_mode(root, LV_SCROLLBAR_MODE_OFF);
+    lv_obj_remove_flag(root, LV_OBJ_FLAG_SCROLLABLE);
+}
+
+bool EndsWithAsciiWordChar(const std::string& text) {
+    if (text.empty()) return false;
+    unsigned char c = static_cast<unsigned char>(text.back());
+    return c < 0x80 && (std::isalnum(c) || c == ')' || c == ']' || c == '"');
+}
+
+bool StartsWithAsciiWordChar(const char* text) {
+    if (!text || !text[0]) return false;
+    unsigned char c = static_cast<unsigned char>(text[0]);
+    return c < 0x80 && (std::isalnum(c) || c == '(' || c == '[' || c == '"');
+}
