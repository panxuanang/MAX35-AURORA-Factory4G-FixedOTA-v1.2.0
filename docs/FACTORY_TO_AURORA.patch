+bool AuroraMax35Display::LooksLikeClock(const char* text) {
+    return text && std::strlen(text) == 5 && std::isdigit(static_cast<unsigned char>(text[0])) &&
+           std::isdigit(static_cast<unsigned char>(text[1])) && text[2] == ':' &&
+           std::isdigit(static_cast<unsigned char>(text[3])) && std::isdigit(static_cast<unsigned char>(text[4]));
+}
+
+bool AuroraMax35Display::IsConversing(DeviceState state) {
+    return state == kDeviceStateConnecting || state == kDeviceStateListening || state == kDeviceStateSpeaking;
+}
+
+const char* AuroraMax35Display::StateText(DeviceState state) {
+    switch (state) {
+        case kDeviceStateStarting: return "正在启动";
+        case kDeviceStateWifiConfiguring: return "等待网络";
+        case kDeviceStateIdle: return "待命";
+        case kDeviceStateConnecting: return "连接 AI";
+        case kDeviceStateListening: return "聆听中";
+        case kDeviceStateSpeaking: return "回答中";
+        case kDeviceStateUpgrading: return "升级中";
+        case kDeviceStateActivating: return "激活中";
+        case kDeviceStateAudioTesting: return "音频测试";
+        case kDeviceStateFatalError: return "系统异常";
+        default: return "准备中";
+    }
+}
+
+uint32_t AuroraMax35Display::StateColor(DeviceState state) {
+    switch (state) {
+        case kDeviceStateListening: return kCyan;
+        case kDeviceStateSpeaking: return kGold;
+        case kDeviceStateConnecting:
+        case kDeviceStateActivating: return kViolet;
+        case kDeviceStateFatalError: return kRed;
+        case kDeviceStateUpgrading: return kGold;
+        default: return kGreen;
+    }
+}
