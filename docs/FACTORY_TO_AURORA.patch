+AuroraMax35Display::AuroraMax35Display(esp_lcd_panel_io_handle_t panel_io, esp_lcd_panel_handle_t panel,
+                                       int width, int height, int offset_x, int offset_y,
+                                       bool mirror_x, bool mirror_y, bool swap_xy)
+    : SpiLcdDisplay(panel_io, panel, width, height, offset_x, offset_y, mirror_x, mirror_y, swap_xy) {
+    BuildAuroraUi();
+
+    esp_timer_create_args_t timer_args = {
+        .callback = &AuroraMax35Display::NotificationTimerCallback,
+        .arg = this,
+        .dispatch_method = ESP_TIMER_TASK,
+        .name = "aurora_notice",
+        .skip_unhandled_events = true,
+    };
+    ESP_ERROR_CHECK(esp_timer_create(&timer_args, &aurora_notification_timer_));
+    ESP_LOGI(TAG, "AURORA UI attached to SpotPear MAX35 factory 4G display");
+}
+
+AuroraMax35Display::~AuroraMax35Display() {
+    if (aurora_notification_timer_) {
+        esp_timer_stop(aurora_notification_timer_);
+        esp_timer_delete(aurora_notification_timer_);
+        aurora_notification_timer_ = nullptr;
+    }
+    aurora_preview_cache_.reset();
+    if (aurora_root_) {
+        DisplayLockGuard lock(this);
+        lv_obj_del(aurora_root_);
+        aurora_root_ = nullptr;
+    }
+}
