+void AuroraMax35Display::UpdateHomeClockInternal() {
+    if (!home_clock_ || !home_date_) return;
+    std::time_t now = std::time(nullptr);
+    std::tm tm{};
+    localtime_r(&now, &tm);
+    if (tm.tm_year < 2025 - 1900) {
+        lv_label_set_text(home_clock_, "--:--");
+        lv_label_set_text(home_date_, "时间同步中");
+        return;
+    }
+    char time_buf[16];
+    char date_buf[48];
+    std::snprintf(time_buf, sizeof(time_buf), "%02d:%02d", tm.tm_hour, tm.tm_min);
+    std::snprintf(date_buf, sizeof(date_buf), "%d月%d日 · %s", tm.tm_mon + 1, tm.tm_mday, WeekdayText(tm.tm_wday));
+    lv_label_set_text(home_clock_, time_buf);
+    lv_label_set_text(home_date_, date_buf);
+}
+
+void AuroraMax35Display::UpdateHomeStateInternal(DeviceState state) {
+    if (!home_state_ || !home_subtitle_ || !home_core_outer_ || !home_core_icon_) return;
+    const uint32_t color = StateColor(state);
+    lv_label_set_text(home_state_, StateText(state));
+    lv_obj_set_style_text_color(home_state_, lv_color_hex(color), 0);
+    lv_obj_set_style_border_color(home_core_outer_, lv_color_hex(color), 0);
+    lv_obj_set_style_shadow_color(home_core_outer_, lv_color_hex(color), 0);
+    lv_obj_set_style_text_color(home_core_icon_, lv_color_hex(color), 0);
+
+    if (!last_system_message_.empty() && state != kDeviceStateIdle) {
+        lv_label_set_text(home_subtitle_, last_system_message_.c_str());
+    } else if (state == kDeviceStateIdle) {
+        lv_label_set_text(home_subtitle_, "ML307 蜂窝网络 · AURORA 已就绪");
+    } else {
+        lv_label_set_text(home_subtitle_, last_status_.empty() ? "ML307 蜂窝网络" : last_status_.c_str());
+    }
+}
+
+void AuroraMax35Display::UpdateChatStateInternal(DeviceState state) {
+    if (!chat_state_ || !chat_state_dot_) return;
+    const uint32_t color = StateColor(state);
+    const char* text = StateText(state);
+    if (waiting_for_answer_ && state == kDeviceStateListening) {
+        text = "思考中";
+    } else if (state == kDeviceStateListening && user_text_.empty()) {
+        text = "正在聆听";
+    }
+    lv_label_set_text(chat_state_, text);
+    lv_obj_set_style_text_color(chat_state_, lv_color_hex(color), 0);
+    lv_obj_set_style_bg_color(chat_state_dot_, lv_color_hex(color), 0);
+}
+
+void AuroraMax35Display::ResetConversationInternal() {
+    user_text_.clear();
+    assistant_text_.clear();
+    last_assistant_fragment_.clear();
+    waiting_for_answer_ = false;
+    scroll_pending_ = false;
+    scroll_due_us_ = 0;
+    scroll_finish_us_ = 0;
+    return_home_us_ = 0;
+    StopReadableScrollInternal();
+    if (chat_user_text_) lv_label_set_text(chat_user_text_, "正在聆听…");
+    if (chat_answer_) lv_label_set_text(chat_answer_, "请说，我在听。");
+    if (chat_footer_) lv_label_set_text(chat_footer_, "回答较长时会自动缓慢滚动");
+}
