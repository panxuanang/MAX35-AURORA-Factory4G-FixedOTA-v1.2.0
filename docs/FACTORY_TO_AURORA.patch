+
+int64_t AuroraMax35Display::StartReadableScrollInternal(int delay_ms, int ms_per_pixel) {
+    if (!chat_answer_ || !chat_answer_box_) return 0;
+    StopReadableScrollInternal();
+    lv_obj_update_layout(chat_answer_);
+    const int visible = lv_obj_get_height(chat_answer_box_) - 52;
+    const int height = lv_obj_get_height(chat_answer_);
+    if (height <= visible) {
+        scroll_finish_us_ = 0;
+        if (chat_footer_) lv_label_set_text(chat_footer_, "完整回答已显示");
+        return 0;
+    }
+
+    const int distance = height - visible;
+    const int duration = std::max(2600, distance * ms_per_pixel);
+    lv_anim_t anim;
+    lv_anim_init(&anim);
+    lv_anim_set_var(&anim, chat_answer_);
+    lv_anim_set_values(&anim, 38, 38 - distance);
+    lv_anim_set_delay(&anim, delay_ms);
+    lv_anim_set_duration(&anim, duration);
+    lv_anim_set_path_cb(&anim, lv_anim_path_linear);
+    lv_anim_set_exec_cb(&anim, [](void* obj, int32_t value) {
+        lv_obj_set_y(static_cast<lv_obj_t*>(obj), value);
+    });
+    lv_anim_start(&anim);
+    if (chat_footer_) lv_label_set_text(chat_footer_, "长回答 · 正在缓慢滚动阅读");
+    scroll_finish_us_ = esp_timer_get_time() + static_cast<int64_t>(delay_ms + duration) * 1000LL;
+    return scroll_finish_us_;
+}
+
+void AuroraMax35Display::ScheduleReadableScrollInternal() {
+    scroll_pending_ = true;
+    scroll_due_us_ = esp_timer_get_time() + kScrollDebounceUs;
+    scroll_finish_us_ = 0;
+}
+
+void AuroraMax35Display::SetStatus(const char* status) {
+    if (!status) return;
+    DisplayLockGuard lock(this);
+    if (LooksLikeClock(status)) {
+        if (home_clock_) lv_label_set_text(home_clock_, status);
+        return;
+    }
+
+    last_status_ = status;
+    const DeviceState state = Application::GetInstance().GetDeviceState();
+    UpdateHomeStateInternal(state);
+
+    if (state == kDeviceStateListening) {
+        if (page_ == Page::Home) {
+            ResetConversationInternal();
+            conversation_active_ = true;
+            ShowPageInternal(Page::Chat);
+        }
+        return_home_us_ = 0;
+        UpdateChatStateInternal(state);
+    } else if (state == kDeviceStateConnecting || state == kDeviceStateSpeaking) {
+        if (conversation_active_ && page_ != Page::Camera) ShowPageInternal(Page::Chat);
+        return_home_us_ = 0;
+        UpdateChatStateInternal(state);
+    } else if (state == kDeviceStateFatalError || state == kDeviceStateUpgrading || state == kDeviceStateActivating) {
+        if (!conversation_active_ && page_ != Page::Camera) ShowPageInternal(Page::Home);
+    }
+}
+
+void AuroraMax35Display::NotificationTimerCallback(void* arg) {
+    auto* self = static_cast<AuroraMax35Display*>(arg);
+    if (!self) return;
+    DisplayLockGuard lock(self);
+    self->SetNotificationVisibleInternal(false);
+}
+
+void AuroraMax35Display::SetNotificationVisibleInternal(bool visible) {
+    if (!notification_panel_) return;
+    if (visible) {
+        lv_obj_remove_flag(notification_panel_, LV_OBJ_FLAG_HIDDEN);
+        lv_obj_move_foreground(notification_panel_);
+    } else {
+        lv_obj_add_flag(notification_panel_, LV_OBJ_FLAG_HIDDEN);
+    }
+}
+
+void AuroraMax35Display::ShowNotification(const char* notification, int duration_ms) {
+    if (!notification || !notification_text_) return;
+    DisplayLockGuard lock(this);
+    lv_label_set_text(notification_text_, notification);
+    SetNotificationVisibleInternal(true);
+    if (aurora_notification_timer_) {
+        esp_timer_stop(aurora_notification_timer_);
+        ESP_ERROR_CHECK(esp_timer_start_once(aurora_notification_timer_, static_cast<uint64_t>(std::max(duration_ms, 500)) * 1000ULL));
+    }
+}
+
+void AuroraMax35Display::SetEmotion(const char* emotion) {
+    if (!emotion || !home_core_icon_) return;
+    const char* glyph = font_awesome_get_utf8(emotion);
+    if (!glyph) glyph = FONT_AWESOME_MICROCHIP_AI;
+    DisplayLockGuard lock(this);
+    lv_label_set_text(home_core_icon_, glyph);
+}
+
+void AuroraMax35Display::SetChatMessage(const char* role, const char* content) {
+    if (!role || !content) return;
+    DisplayLockGuard lock(this);
+
+    if (std::strcmp(role, "system") == 0) {
+        if (content[0]) {
+            const DeviceState state = Application::GetInstance().GetDeviceState();
+            // Application prints the User-Agent into the display at boot. Keep that diagnostic
+            // out of the product UI, but preserve later system/error messages.
+            if (!(state == kDeviceStateStarting && std::strchr(content, '/') != nullptr)) {
+                last_system_message_ = content;
+                if (!conversation_active_ && page_ == Page::Home) {
+                    lv_label_set_text(home_subtitle_, content);
+                }
+            }
+        }
+        return;
+    }
+
+    if (!content[0]) return;
+
+    if (page_ == Page::Camera) {
+        esp_timer_stop(preview_timer_);
+        aurora_preview_cache_.reset();
+        if (camera_image_) lv_obj_add_flag(camera_image_, LV_OBJ_FLAG_HIDDEN);
+    }
+
+    if (std::strcmp(role, "user") == 0) {
+        conversation_active_ = true;
+        waiting_for_answer_ = true;
+        return_home_us_ = 0;
+        user_text_ = content;
+        assistant_text_.clear();
+        last_assistant_fragment_.clear();
+        scroll_pending_ = false;
+        scroll_due_us_ = 0;
+        scroll_finish_us_ = 0;
+        StopReadableScrollInternal();
+        ShowPageInternal(Page::Chat);
+        lv_label_set_text(chat_user_text_, user_text_.c_str());
+        lv_label_set_text(chat_answer_, "我听到了，正在整理回答…");
+        lv_obj_set_y(chat_answer_, 38);
+        lv_label_set_text(chat_footer_, "正在思考");
+        UpdateChatStateInternal(Application::GetInstance().GetDeviceState());
+        return;
+    }
+
+    if (std::strcmp(role, "assistant") == 0) {
+        conversation_active_ = true;
+        waiting_for_answer_ = false;
+        return_home_us_ = 0;
+        ShowPageInternal(Page::Chat);
+
+        std::string fragment(content);
+        if (fragment == last_assistant_fragment_) {
+            return;
+        }
+        last_assistant_fragment_ = fragment;
+
+        // Support both server styles: cumulative text and sentence-by-sentence text.
+        if (assistant_text_.empty()) {
+            assistant_text_ = fragment;
+        } else if (fragment.rfind(assistant_text_, 0) == 0) {
+            assistant_text_ = fragment;
+        } else if (assistant_text_.size() >= fragment.size() &&
+                   assistant_text_.compare(assistant_text_.size() - fragment.size(), fragment.size(), fragment) == 0) {
+            // Duplicate suffix; keep existing text.
+        } else {
+            if (EndsWithAsciiWordChar(assistant_text_) && StartsWithAsciiWordChar(fragment.c_str())) {
+                assistant_text_ += ' ';
+            } else {
+                assistant_text_ += '\n';
+            }
+            assistant_text_ += fragment;
+        }
+
+        SetAssistantTextInternal(assistant_text_);
+        ScheduleReadableScrollInternal();
+        lv_label_set_text(chat_footer_, "回答会完整保留；超出一屏后自动滚动");
+        UpdateChatStateInternal(Application::GetInstance().GetDeviceState());
+    }
+}
+
+void AuroraMax35Display::SetPreviewImage(std::unique_ptr<LvglImage> image) {
+    DisplayLockGuard lock(this);
+    if (!camera_root_ || !camera_image_) return;
+
+    if (!image) {
+        FinishCameraPreviewInternal();
+        return;
+    }
+
+    page_before_camera_ = (page_ == Page::Camera) ? page_before_camera_ : page_;
+    aurora_preview_cache_ = std::move(image);
+    auto* dsc = aurora_preview_cache_->image_dsc();
+    if (!dsc || dsc->header.w == 0 || dsc->header.h == 0) {
+        ESP_LOGW(TAG, "Camera preview image has invalid dimensions");
+        aurora_preview_cache_.reset();
+        return;
+    }
+
+    lv_image_set_src(camera_image_, dsc);
+    const int max_w = 456;
+    const int max_h = 252;
+    const int zoom_w = max_w * 256 / static_cast<int>(dsc->header.w);
+    const int zoom_h = max_h * 256 / static_cast<int>(dsc->header.h);
+    int zoom = std::min(zoom_w, zoom_h);
+    if (zoom > 256) zoom = 256;
+    if (zoom < 1) zoom = 1;
+    lv_image_set_scale(camera_image_, zoom);
+    lv_obj_remove_flag(camera_image_, LV_OBJ_FLAG_HIDDEN);
+    lv_label_set_text(camera_status_, "原厂 Camera::Capture() 预览");
+    ShowPageInternal(Page::Camera);
+
+    esp_timer_stop(preview_timer_);
+    ESP_ERROR_CHECK(esp_timer_start_once(preview_timer_, PREVIEW_IMAGE_DURATION_MS * 1000ULL));
+}
+
+void AuroraMax35Display::FinishCameraPreviewInternal() {
+    esp_timer_stop(preview_timer_);
+    if (camera_image_) lv_obj_add_flag(camera_image_, LV_OBJ_FLAG_HIDDEN);
+    aurora_preview_cache_.reset();
+    Page target = page_before_camera_;
+    if (conversation_active_) target = Page::Chat;
+    ShowPageInternal(target);
+}
+
+void AuroraMax35Display::CopyFactoryStatusIconsInternal() {
+    if (home_network_ && network_label_) {
+        const char* text = lv_label_get_text(network_label_);
+        lv_label_set_text(home_network_, text ? text : "");
+    }
+    if (home_battery_ && battery_label_) {
+        const char* text = lv_label_get_text(battery_label_);
+        lv_label_set_text(home_battery_, text ? text : "");
+    }
+    if (home_mute_ && mute_label_) {
+        const char* text = lv_label_get_text(mute_label_);
+        lv_label_set_text(home_mute_, text ? text : "");
+    }
+}
+
+void AuroraMax35Display::UpdateStatusBar(bool update_all) {
+    // Keep the factory battery/network acquisition path intact. The original labels are hidden;
+    // AURORA only mirrors their glyphs into the new home page.
+    LvglDisplay::UpdateStatusBar(update_all);
+
+    const DeviceState state = Application::GetInstance().GetDeviceState();
+    const int64_t now = esp_timer_get_time();
+
+    DisplayLockGuard lock(this);
+    CopyFactoryStatusIconsInternal();
+    UpdateHomeClockInternal();
+
+    if (state != last_state_) {
+        if (state == kDeviceStateListening && page_ == Page::Home) {
+            ResetConversationInternal();
+            conversation_active_ = true;
+            ShowPageInternal(Page::Chat);
+        }
+        if (IsConversing(state)) return_home_us_ = 0;
+        UpdateHomeStateInternal(state);
+        UpdateChatStateInternal(state);
+        last_state_ = state;
+    } else if (page_ == Page::Home) {
+        UpdateHomeStateInternal(state);
+    }
+
+    if (page_ == Page::Chat && scroll_pending_ && now >= scroll_due_us_) {
+        scroll_pending_ = false;
+        scroll_due_us_ = 0;
+        StartReadableScrollInternal();
+    }
+
+    if (page_ == Page::Chat && conversation_active_) {
+        if (state == kDeviceStateIdle) {
+            if (scroll_pending_) {
+                return_home_us_ = 0;
+            } else if (scroll_finish_us_ > now) {
+                return_home_us_ = scroll_finish_us_ + kAfterScrollDelayUs;
+            } else if (return_home_us_ == 0) {
+                return_home_us_ = now + kReturnHomeDelayUs;
+            }
+        } else if (IsConversing(state)) {
+            return_home_us_ = 0;
+        }
+
+        if (return_home_us_ > 0 && now >= return_home_us_) {
+            conversation_active_ = false;
+            waiting_for_answer_ = false;
+            return_home_us_ = 0;
+            scroll_finish_us_ = 0;
+            scroll_pending_ = false;
+            ShowPageInternal(Page::Home);
+            UpdateHomeStateInternal(state);
+        }
+    }
+}
