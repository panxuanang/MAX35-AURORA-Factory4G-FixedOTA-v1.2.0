+const char* AuroraMax35Display::WeekdayText(int weekday) {
+    static const char* kWeekdays[] = {"周日", "周一", "周二", "周三", "周四", "周五", "周六"};
+    return (weekday >= 0 && weekday < 7) ? kWeekdays[weekday] : "";
+}
